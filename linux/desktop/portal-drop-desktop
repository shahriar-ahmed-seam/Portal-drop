def resolve_portal_binary():
    explicit = os.environ.get("PORTAL_DROP_BINARY")
    if explicit:
        return explicit
    sibling = Path(__file__).resolve().parent / "portal-drop"
    if sibling.is_file():
        return str(sibling)
    on_path = shutil.which("portal-drop")
    if on_path:
        return on_path
    return str(Path.home() / ".local/bin/portal-drop")


