def run_cli(*args, data=None):
    result = subprocess.run(
        [PORTAL, *args],
        input=None if data is None else data.encode("utf-8"),
        capture_output=True,
        check=True,
    )
    return result.stdout.decode("utf-8")


def get_json(*args):
    return json.loads(run_cli(*args))


def service_ctl(action):
    subprocess.run(
        ["systemctl", "--user", action, SERVICE],
        check=True,
        capture_output=True,
        text=True,
    )


def service_active():
    return (
        subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", SERVICE],
            capture_output=True,
        ).returncode
        == 0
    )


class LocalHotspot:
    BUS = "org.freedesktop.NetworkManager"
    ROOT = "/org/freedesktop/NetworkManager"
    DEVICE = f"{BUS}.Device"
    WIRELESS = f"{DEVICE}.Wireless"
    ACTIVE = f"{BUS}.Connection.Active"
    IP4 = f"{BUS}.IP4Config"
    WIFI = 2
    WIFI_AP = 0x40
    WIFI_RSN = 0x20
    DEVICE_DISCONNECTED = 30
    DEVICE_ACTIVATED = 100
    ACTIVATING = 1
    ACTIVATED = 2

    def __init__(self):
        self.lock = threading.Lock()
        self.active = None
        self.bus = None

    def call(self, path, interface, method, parameters=None, interactive=False):
        if self.bus is None or self.bus.is_closed():
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        flags = (Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION if interactive
                 else Gio.DBusCallFlags.NO_AUTO_START)
        return self.bus.call_sync(
            self.BUS, path, interface, method, parameters, None,
            flags, 30_000 if interactive else 3_000, None,
        ).unpack()

    def properties(self, path, interface):
        return self.call(path, "org.freedesktop.DBus.Properties", "GetAll",
                         GLib.Variant("(s)", (interface,)))[0]

    def adapters(self):
        paths = self.call(self.ROOT, self.BUS, "GetDevices")[0]
        adapters = []
        for path in paths:
            try:
                device = self.properties(path, self.DEVICE)
                if device.get("DeviceType") != self.WIFI or not device.get("Managed"):
                    continue
                state = device.get("State", 0)
                if not self.DEVICE_DISCONNECTED <= state <= self.DEVICE_ACTIVATED:
                    continue
                wireless = self.properties(path, self.WIRELESS)
                caps = wireless.get("WirelessCapabilities", 0)
                # Avoid taking over a hotspot created outside Portal Drop.
                protected_ap = self.WIFI_AP | self.WIFI_RSN
                if wireless.get("Mode") == 3 or caps & protected_ap != protected_ap:
                    continue
                adapters.append({"device": path, "interface": device["Interface"],
                                 "connected": state != self.DEVICE_DISCONNECTED})
            except GLib.Error:
                # An adapter can disappear between the device list and its properties.
                continue
        return sorted(adapters, key=lambda adapter: (adapter["connected"], adapter["interface"]))

    def info(self):
        if self.active is None:
            return None
        path, config = self.active
        try:
            active = self.properties(path, self.ACTIVE)
        except GLib.Error as error:
            # NetworkManager removes the active object on disconnect.
            if Gio.DBusError.get_remote_error(error) not in (
                "org.freedesktop.DBus.Error.UnknownObject", "org.freedesktop.DBus.Error.UnknownMethod",
            ):
                raise
            active = {}
        if active.get("State") not in (self.ACTIVATING, self.ACTIVATED):
            self.active = None
            return None
        ip_config = active.get("Ip4Config")
        addresses = self.properties(ip_config, self.IP4).get("AddressData", []) if ip_config and ip_config != "/" else []
        address = next((row["address"] for row in addresses if row.get("address")), None)
        return {**config, "address": address, "ready": bool(address and active["State"] == self.ACTIVATED)}

    def status(self):
        with self.lock:
            hotspot = self.info()
            if hotspot:
                return {"active": hotspot, "adapters": []}
            try:
                adapters = self.adapters()
            except GLib.Error:
                return {"active": None, "adapters": [], "reason": "NetworkManager is unavailable."}
            reason = None if adapters else "No available Wi-Fi adapter supports a protected hotspot."
            return {"active": None, "adapters": adapters, "reason": reason}

    def start(self, device_path):
        with self.lock:
            hotspot = self.info()
            if hotspot:
                return hotspot
            adapter = next((item for item in self.adapters() if item["device"] == device_path), None)
            if adapter is None:
                raise RuntimeError("Choose an available Wi-Fi adapter.")
            service_ctl("start")
            ssid = f"Portal Drop {secrets.token_hex(3).upper()}"
            password = secrets.token_urlsafe(15)
            variant = GLib.Variant
            settings = {
                "connection": {
                    "id": variant("s", ssid), "type": variant("s", "802-11-wireless"),
                    "autoconnect": variant("b", False),
                },
                "802-11-wireless": {"ssid": variant("ay", ssid.encode("ascii")), "mode": variant("s", "ap")},
                "802-11-wireless-security": {
                    "key-mgmt": variant("s", "wpa-psk"), "proto": variant("as", ["rsn"]),
                    "psk": variant("s", password),
                },
                "ipv4": {"method": variant("s", "shared"), "never-default": variant("b", True)},
                "ipv6": {"method": variant("s", "disabled")},
            }
            options = {"persist": variant("s", "volatile"), "bind-activation": variant("s", "dbus-client")}
            try:
                _, path, _ = self.call(
                    self.ROOT, self.BUS, "AddAndActivateConnection2",
                    variant("(a{sa{sv}}ooa{sv})", (settings, device_path, "/", options)), interactive=True,
                )
            except GLib.Error as error:
                raise RuntimeError("NetworkManager could not start the hotspot. Check the adapter and Wi-Fi permissions.") from error
            self.active = (path, {"ssid": ssid, "password": password, "interface": adapter["interface"]})
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                hotspot = self.info()
                if hotspot is None:
                    raise RuntimeError("The Wi-Fi adapter could not activate the hotspot.")
                if hotspot["ready"]:
                    return hotspot
                time.sleep(0.25)
            self.deactivate()
            raise RuntimeError("The hotspot did not receive a local IP address.")

    def deactivate(self):
        if self.active is not None:
            self.call(self.ROOT, self.BUS, "DeactivateConnection",
                      GLib.Variant("(o)", (self.active[0],)), interactive=True)
            self.active = None

    def stop(self):
        with self.lock:
            if self.info():
                self.deactivate()


def error_details(error):
    details = getattr(error, "stderr", None) or str(error)
    return details.decode(errors="replace").strip() if isinstance(details, bytes) else str(details).strip()


def data_dir_path():
    env_dir = os.environ.get("PORTAL_DROP_DATA_DIR")
    if env_dir:
        return Path(env_dir)
    xdg = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    return Path(xdg) / "portal-drop"


def config_dir_path():
    xdg = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(xdg) / "portal-drop"


def prefs_path():
    return config_dir_path() / "ui-prefs.json"


def load_prefs():
    try:
        raw = prefs_path().read_text(encoding="utf-8")
        data = json.loads(raw)
        if isinstance(data, dict):
            return {"theme": "light", "minimizeToTray": False, **data}
    except Exception:
        pass
    return {"theme": "light", "minimizeToTray": False}


def save_prefs(prefs):
    if not isinstance(prefs, dict):
        return
    path = prefs_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(prefs, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def find_ui_html():
    explicit = os.environ.get("PORTAL_DROP_UI")
    if explicit and Path(explicit).is_file():
        return Path(explicit).resolve()
    here = Path(__file__).resolve()
    xdg = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local/share"))
    candidates = []
    if len(here.parents) > 2:
        candidates.append(here.parents[2] / "desktop-ui" / "index.html")
    if len(here.parents) > 1:
        candidates.append(here.parents[1] / "share" / "portal-drop" / "ui" / "index.html")
    candidates.extend(
        [
            xdg / "portal-drop" / "ui" / "index.html",
            Path("/usr/share/portal-drop/ui/index.html"),
            here.parent / "ui" / "index.html",
        ]
    )
    for path in candidates:
        if path.is_file():
            return path.resolve()
    raise FileNotFoundError(
        "Portal Drop UI file (index.html) not found. Reinstall Portal Drop."
    )


def open_uri(uri):
    Gio.AppInfo.launch_default_for_uri(uri, None)


def show_in_file_manager(path_str):
    target = Path(path_str).resolve()
    uri = target.as_uri()
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync(
            "org.freedesktop.FileManager1",
            "/org/freedesktop/FileManager1",
            "org.freedesktop.FileManager1",
            "ShowItems",
            GLib.Variant("(ass)", ([uri], "")),
            None,
            Gio.DBusCallFlags.NONE,
            1500,
            None,
        )
        return
    except Exception:
        pass
    folder = target.parent if target.is_file() else target
    open_uri(folder.as_uri())


def queue_files_cli(payload, paths):
    chat_id = str(payload.get("chatId") or DEFAULT_CHAT)
    base_args = ["--chat", chat_id]
    if payload.get("replyTo"):
        base_args.extend(["--reply-to", str(payload["replyTo"])])
    if payload.get("ttl"):
        base_args.extend(["--ttl", str(int(payload["ttl"]))])
    sent = 0
    skipped = 0
    errors = []
    for raw in paths:
        p = Path(raw)
        if not p.is_file() and not p.is_dir():
            skipped += 1
            continue
        try:
            if p.is_dir():
                sent += get_json("send-folder", *base_args, "--", str(p))["sent"]
            else:
                run_cli("send-file", *base_args, "--", str(p))
                sent += 1
        except (OSError, subprocess.CalledProcessError) as error:
            errors.append(f"{p.name}: {error_details(error)}")
    if errors and sent == 0:
        raise RuntimeError("\n".join(errors))
    return {"sent": sent, "skipped": skipped, "errors": errors}


class PortalTray:
    watcher_name = "org.kde.StatusNotifierWatcher"

    def __init__(self, window):
        self.window = window
        self.available = False
        self.hidden = False
        self.closed = False
        self.busy = False
        self.cursor = None
        self.unread = 0
        self.chat_id = DEFAULT_CHAT
        self.active = True
        self.status = {}
        self.indicator = None
        self.watcher = None
        self.watcher_has_host = False
        self.indicator_connected = False
        self.badge_dir = None
        self.displayed_badge = None
        self.cancellable = Gio.Cancellable()

        self.menu = Gtk.Menu()
        self.summary = Gtk.MenuItem.new_with_label("Waiting")
        self.summary.set_sensitive(False)
        self.menu.append(self.summary)
        self.add_item("Open Portal Drop", window.get_application().activate)
        self.clipboard_item = self.add_item("Send clipboard", self.send_clipboard)
        self.service_item = self.add_item("Pause service", self.toggle_service)
        self.menu.append(Gtk.SeparatorMenuItem())
        self.add_item("Quit Portal Drop", window.close_for_real)
        self.menu.show_all()

        self.legacy = Gtk.StatusIcon.new_from_icon_name(APP_ID)
        self.legacy.set_title("Portal Drop")
        self.legacy.connect("activate", lambda *_: window.get_application().activate())
        self.legacy.connect("popup-menu", self.popup)
        self.legacy.connect("notify::embedded", lambda *_: self.update_availability())
        self.timer = GLib.timeout_add_seconds(5, self.poll)
        if AyatanaAppIndicator3 is not None:
            Gio.DBusProxy.new_for_bus(
                Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
                self.watcher_name, "/StatusNotifierWatcher", self.watcher_name,
                self.cancellable, self.watcher_ready, None,
            )
        self.update_availability()
        self.render()

    def add_item(self, label, action):
        item = Gtk.MenuItem.new_with_label(label)
        item.connect("activate", lambda *_: action())
        self.menu.append(item)
        return item

    def popup(self, icon, button, timestamp):
        self.menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, timestamp)

    def watcher_ready(self, _source, result, _data):
        if self.closed:
            return
        try:
            self.watcher = Gio.DBusProxy.new_for_bus_finish(result)
        except GLib.Error:
            return
        self.watcher.connect("notify::g-name-owner", self.check_watcher)
        self.watcher.connect("g-properties-changed", self.check_watcher)
        self.check_watcher()

    def check_watcher(self, *_args):
        if self.closed:
            return
        registered = self.watcher.get_cached_property("IsStatusNotifierHostRegistered")
        self.watcher_has_host = bool(self.watcher.get_name_owner() and registered and registered.get_boolean())
        if self.watcher_has_host and self.indicator is None:
            api = AyatanaAppIndicator3
            self.indicator = api.Indicator.new(APP_ID, APP_ID, api.IndicatorCategory.APPLICATION_STATUS)
            self.indicator.connect("connection-changed", self.indicator_connection)
            self.indicator.set_menu(self.menu)
            self.render()
        if self.indicator is not None:
            status = AyatanaAppIndicator3.IndicatorStatus
            self.indicator.set_status(status.ACTIVE if self.watcher_has_host else status.PASSIVE)
        self.update_availability()

    def indicator_connection(self, _indicator, connected):
        self.indicator_connected = connected
        self.update_availability()

    def update_availability(self):
        if self.closed:
            return
        use_indicator = self.watcher_has_host and self.indicator_connected
        if self.legacy.get_visible() == use_indicator:
            self.legacy.set_visible(not use_indicator)
        available = use_indicator or self.legacy.is_embedded()
        if available == self.available:
            return
        self.available = available
        if self.hidden and not self.available:
            self.window.get_application().activate()
        self.window.js_call("__portalWake", {"reason": "tray"})
        self.poll()

    def set_snapshot(self, active, status, chat_id):
        if not self.closed:
            self.active, self.status, self.chat_id = active, status, chat_id
            self.render()
        return False

    def mark_read(self, *_args):
        if self.window.is_active() and self.unread:
            self.unread = 0
            self.render()

    def poll(self):
        if self.closed:
            return False
        if not self.available or self.busy:
            return True
        self.busy = True
        cursor = self.cursor

        def read():
            active = service_active()
            status = get_json("status", "--json")
            if cursor is None:
                latest = get_json("history", "--json", "--limit", "1")["items"]
                return active, status, latest[0]["seq"] if latest else 0, 0
            rows = get_json("events", "--json", "--after", str(cursor), "--limit", "200")
            return (
                active, status, rows[-1]["seq"] if rows else cursor,
                sum(row["direction"] == "received" for row in rows),
            )

        def finished(job):
            self.busy = False
            if not self.closed:
                try:
                    self.active, self.status, self.cursor, incoming = job.result()
                except (OSError, subprocess.CalledProcessError, ValueError):
                    return False
                if self.window.is_active():
                    self.unread = 0
                else:
                    self.unread += incoming
                self.render()
            return False

        self.window.work.submit(read).add_done_callback(lambda job: GLib.idle_add(finished, job))
        return True

    def render(self):
        state = "Paused" if not self.active else "Connected" if self.status.get("connected") else "Waiting"
        details = f"{state} · {self.unread} unread" if self.unread else state
        self.summary.set_label(details)
        self.legacy.set_tooltip_text(f"Portal Drop · {details}")
        self.service_item.set_label("Pause service" if self.active else "Resume service")
        self.clipboard_item.set_sensitive(bool(self.status.get("paired")))

        badge = str(self.unread) if 0 < self.unread < 100 else ("99+" if self.unread else "")
        if badge == self.displayed_badge:
            if self.indicator is not None:
                self.indicator.set_label(badge, "99+")
            return
        self.displayed_badge = badge
        self.legacy.set_from_icon_name(APP_ID)
        if self.indicator is not None:
            self.indicator.set_icon_full(APP_ID, details)
            self.indicator.set_label(badge, "99+")
        if not badge:
            return
        try:
            icon = Gtk.IconTheme.get_default().load_icon(APP_ID, 48, Gtk.IconLookupFlags.FORCE_SIZE).copy()
            graphic = (
                '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48">'
                '<rect x="18" y="27" width="30" height="21" rx="9" fill="#00684d" stroke="#ffffff"/>'
                f'<text x="33" y="42" text-anchor="middle" fill="#fff" font-size="15" '
                f'font-family="sans-serif" font-weight="bold">{badge}</text></svg>'
            )
            overlay = GdkPixbuf.PixbufLoader.new_with_type("svg")
            overlay.write(graphic.encode("utf-8"))
            overlay.close()
            overlay.get_pixbuf().composite(
                icon, 0, 0, 48, 48, 0, 0, 1, 1, GdkPixbuf.InterpType.NEAREST, 255,
            )
            self.legacy.set_from_pixbuf(icon)
            if self.indicator is not None:
                if self.badge_dir is None:
                    self.badge_dir = tempfile.TemporaryDirectory(prefix="portal-drop-tray-")
                path = Path(self.badge_dir.name) / f"unread-{badge}.png"
                icon.savev(str(path), "png", [], [])
                self.indicator.set_icon_full(str(path), details)
        except (GLib.Error, OSError, AttributeError):
            pass

    def toggle_service(self):
        action = "stop" if self.active else "start"

        def finished(job):
            try:
                job.result()
            except (OSError, subprocess.CalledProcessError) as error:
                self.feedback("Could not change Portal Drop service", error_details(error))
            else:
                self.active = action == "start"
                self.render()
                self.poll()
                self.window.js_call("__portalWake", {"reason": "service"})
            return False

        self.window.work.submit(service_ctl, action).add_done_callback(lambda job: GLib.idle_add(finished, job))

    def send_clipboard(self):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        if clipboard is not None:
            clipboard.request_text(self.clipboard_text, None)

    def clipboard_text(self, _clipboard, text, _data):
        if self.closed:
            return
        if not text or not text.strip():
            self.feedback("Send clipboard", "The clipboard has no readable text.")
            return
        chat = self.chat_id

        def queue():
            destination = get_json("snapshot", "--chat", chat, "--limit", "1")["chat_id"]
            run_cli("send-text", "--chat", destination, "--ttl", "300", "-", data=text)

        def finished(job):
            try:
                job.result()
            except (OSError, subprocess.CalledProcessError) as error:
                self.feedback("Could not queue clipboard", error_details(error))
            else:
                self.feedback("Clipboard queued", "Temporary text will expire after five minutes.")
            return False

        self.window.work.submit(queue).add_done_callback(lambda job: GLib.idle_add(finished, job))

    def feedback(self, title, body):
        if self.closed:
            return
        notification = Gio.Notification.new(title)
        notification.set_body(body)
        notification.set_icon(Gio.ThemedIcon.new(APP_ID))
        self.window.get_application().send_notification("portal-tray-action", notification)

    def close(self):
        self.closed = True
        self.cancellable.cancel()
        GLib.source_remove(self.timer)
        self.legacy.set_visible(False)
        if self.indicator is not None:
            self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.PASSIVE)
        if self.badge_dir is not None:
            self.badge_dir.cleanup()


class PortalWindow(Gtk.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title="Portal Drop")
        self.get_style_context().add_class("portal-host")
        self.set_icon_name(APP_ID)
        self.set_default_size(1100, 740)
        self.set_size_request(680, 480)

        self.work = ThreadPoolExecutor(max_workers=4)
        self.hotspot = LocalHotspot()
        self.closed = False
        self.ui_ready = False
        self.queued_js = []
        self.drag_active = False
        self.chrome_provider = Gtk.CssProvider()

        prefs = load_prefs()
        self.minimize_to_tray = prefs.get("minimizeToTray") is True
        self.force_close = False
        initial_theme = prefs.get("theme", "light")
        if initial_theme not in ("light", "dark"):
            initial_theme = self._detect_system_theme()

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("Portal Drop")
        self.set_titlebar(header)

        ucm = WebKit2.UserContentManager()
        ucm.register_script_message_handler("portal")
        ucm.connect("script-message-received::portal", self.on_ipc_message)

        boot_js = (
            'window.__PORTAL_HOST = "linux";\n'
            f"window.__PORTAL_PREFS = {json.dumps(prefs)};\n"
        )
        ucm.add_script(
            WebKit2.UserScript(
                boot_js,
                WebKit2.UserContentInjectedFrames.TOP_FRAME,
                WebKit2.UserScriptInjectionTime.START,
                None,
                None,
            )
        )

        self.webview = WebKit2.WebView.new_with_user_content_manager(ucm)
        self.webview.set_hexpand(True)
        self.webview.set_vexpand(True)

        settings = self.webview.get_settings()
        settings.set_allow_file_access_from_file_urls(True)
        settings.set_allow_universal_access_from_file_urls(True)
        settings.set_enable_smooth_scrolling(True)
        settings.set_javascript_can_access_clipboard(True)
        if os.environ.get("PORTAL_DROP_DEVTOOLS"):
            settings.set_enable_developer_extras(True)

        self.ui_file = find_ui_html()
        self.ui_uri = self.ui_file.as_uri()
        self.webview.connect("load-changed", self.on_load_changed)
        self.webview.connect("decide-policy", self.on_decide_policy)
        self.webview.connect("key-press-event", self.on_clipboard_key)

        # Handle file drops before WebKit's handlers, including GTK's portal URI targets.
        self.webview.drag_dest_set(Gtk.DestDefaults(0), [], Gdk.DragAction.COPY)
        self.webview.drag_dest_add_uri_targets()
        self.webview.connect("drag-motion", self.on_drag_motion)
        self.webview.connect("drag-drop", self.on_drag_drop)
        self.webview.connect("drag-leave", self.on_drag_leave)
        self.webview.connect("drag-data-received", self.on_drag_data_received)

        self.add(self.webview)

        screen = Gdk.Screen.get_default()
        if screen is not None:
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                self.chrome_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )
        self.apply_native_theme(initial_theme)

        self.webview.load_uri(self.ui_uri)
        self.connect("delete-event", self.on_close)
        self.show_all()
        self.tray = PortalTray(self)
        self.connect("notify::is-active", self.tray.mark_read)
        self.start_daemon_watcher()

    def _detect_system_theme(self):
        try:
            out = subprocess.run(
                ["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
                capture_output=True,
                text=True,
                timeout=1,
            ).stdout
            if "dark" in out.lower():
                return "dark"
        except Exception:
            pass
        return "light"

    def apply_native_theme(self, theme):
        mode = "dark" if theme == "dark" else "light"
        settings = Gtk.Settings.get_default()
        if settings is not None:
            settings.set_property("gtk-application-prefer-dark-theme", mode == "dark")
        self.chrome_provider.load_from_data(CHROME_FRAME_CSS + CHROME_CSS[mode])
        rgba = Gdk.RGBA()
        rgba.parse("#1f2a26" if mode == "dark" else "#ffffff")
        self.webview.set_background_color(rgba)

    def on_load_changed(self, _webview, event):
        if event == WebKit2.LoadEvent.FINISHED:
            self.ui_ready = True
            pending, self.queued_js = self.queued_js, []
            for script in pending:
                self._eval_js_now(script)

    def on_clipboard_key(self, view, event):
        modifiers = Gtk.accelerator_get_default_mod_mask()
        if event.state & modifiers != Gdk.ModifierType.CONTROL_MASK or Gdk.keyval_to_lower(event.keyval) != Gdk.KEY_v:
            return False
        view.evaluate_javascript("document.activeElement?.id === 'composer' && typeof state !== 'undefined' ? state.chatId : ''", -1,
                                 None, None, None, self.on_paste_focus, None)
        return True

    def on_paste_focus(self, view, result, _data):
        if self.closed:
            return
        try:
            chat_id = view.evaluate_javascript_finish(result).to_string()
        except GLib.Error:
            return
        if not chat_id:
            view.execute_editing_command("Paste")
            return
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).request_targets(self.on_paste_targets, chat_id)

    def on_paste_targets(self, clipboard, targets, _count, chat_id):
        if self.closed:
            return
        available = {target.name(): target for target in targets or []}
        for mime_type in CLIPBOARD_IMAGE_TYPES:
            if mime_type in available:
                clipboard.request_contents(available[mime_type], self.on_paste_image, (mime_type, chat_id))
                return
        self.webview.execute_editing_command("Paste")

    def on_paste_image(self, _clipboard, selection, context):
        if self.closed:
            return
        mime_type, chat_id = context
        length = selection.get_length()
        if length <= 0 or length > MAX_CLIPBOARD_IMAGE:
            self.js_call("__portalClipboardImage", {"chatId": chat_id, "error": "Clipboard images must be between 1 byte and 16 MiB."})
            return
        encoded = base64.b64encode(selection.get_data()).decode("ascii")
        self.js_call("__portalClipboardImage", {"chatId": chat_id, "mimeType": mime_type, "base64": encoded})

    def on_decide_policy(self, _webview, decision, decision_type):
        if decision_type in (
            WebKit2.PolicyDecisionType.NAVIGATION_ACTION,
            WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION,
        ):
            nav = decision.get_navigation_action()
            req = nav.get_request() if nav else None
            uri = req.get_uri() if req else ""
            if uri and uri != self.ui_uri and not uri.startswith(self.ui_uri + "?"):
                if uri.startswith(("http://", "https://")):
                    try:
                        open_uri(uri)
                    except Exception:
                        pass
                decision.ignore()
                return True
        return False

    def on_close(self, _window, _event):
        if self.minimize_to_tray and self.tray.available and not self.force_close:
            self.tray.hidden = True
            self.hide()
            return True
        self.closed = True
        self.tray.close()
        self.work.shutdown(wait=False, cancel_futures=True)
        return False

    def close_for_real(self):
        self.force_close = True
        self.close()

    def restore(self):
        self.tray.hidden = False
        self.show()
        self.present()

    def _eval_js_now(self, script):
        if self.closed:
            return
        self.webview.evaluate_javascript(script, -1, None, None, None, None, None)

    def js_call(self, fn_name, arg=None):
        encoded = json.dumps(arg if arg is not None else {})
        script = f"window.{fn_name} && window.{fn_name}({encoded});"

        def dispatch():
            if self.closed:
                return False
            if self.ui_ready:
                self._eval_js_now(script)
            else:
                self.queued_js.append(script)
            return False

        GLib.idle_add(dispatch)

    def reply(self, req_id, ok=True, data=None, error=None):
        if req_id is None:
            return
        payload = {"req_id": req_id, "ok": ok}
        if ok:
            payload["data"] = data
        else:
            payload["error"] = str(error or "Action failed")
        self.js_call("__portalReply", payload)

    def open_chat(self, chat_id, reply_to=None):
        self.js_call("__portalOpenChat", {"chatId": chat_id, "replyTo": reply_to})

    def on_drag_motion(self, widget, context, _x, _y, timestamp):
        target = widget.drag_dest_find_target(context, None)
        valid = bool(target) and bool(context.get_actions() & Gdk.DragAction.COPY)
        Gdk.drag_status(context, Gdk.DragAction.COPY if valid else Gdk.DragAction(0), timestamp)
        if valid != self.drag_active:
            self.drag_active = valid
            self.js_call("__portalDragEnter" if valid else "__portalDragLeave")
        return True

    def on_drag_drop(self, widget, context, _x, _y, timestamp):
        target = widget.drag_dest_find_target(context, None)
        if target and context.get_actions() & Gdk.DragAction.COPY:
            widget.drag_get_data(context, target, timestamp)
        else:
            self.on_drag_leave(widget, context, timestamp)
            Gtk.drag_finish(context, False, False, timestamp)
        return True

    def on_drag_leave(self, _widget, _context, _timestamp):
        if self.drag_active:
            self.drag_active = False
            self.js_call("__portalDragLeave", {})

    def on_drag_data_received(self, widget, context, _x, _y, selection, _info, timestamp):
        widget.stop_emission_by_name("drag-data-received")
        self.drag_active = False
        uris = selection.get_uris() if selection else []
        paths = []
        for uri in uris:
            p = Gio.File.new_for_uri(uri).get_path()
            if p:
                paths.append(p)
        Gtk.drag_finish(context, bool(paths), False, timestamp)
        if paths:
            self.js_call("__portalDropFiles", {"paths": paths})
        else:
            self.js_call("__portalDragLeave", {})

    def start_daemon_watcher(self):
        def watch_loop():
            wake_file = data_dir_path() / "wake.json"
            while not self.closed:
                try:
                    cfg = json.loads(wake_file.read_text(encoding="utf-8"))
                    with socket.create_connection(("127.0.0.1", int(cfg["port"])), timeout=2.0) as sock:
                        sock.settimeout(None)
                        sock.sendall(f"watch {cfg['token']}\n".encode("utf-8"))
                        reader = sock.makefile("r", encoding="utf-8")
                        for line in reader:
                            if self.closed:
                                return
                            event = line.strip()
                            if event and event != "ping":
                                self.js_call("__portalWake", {"reason": event})
                                if event in ("ready", "inbox", "presence", "pair"):
                                    GLib.idle_add(self.poll_tray)
                except OSError:
                    time.sleep(1.2)
                except Exception:
                    time.sleep(2.0)

        threading.Thread(target=watch_loop, name="portal-drop-watch", daemon=True).start()

    def poll_tray(self):
        self.tray.poll()
        return False

    def on_ipc_message(self, _ucm, js_result):
        try:
            raw = js_result.get_js_value().to_string()
            msg = json.loads(raw)
        except Exception:
            return
        req_id = msg.get("req_id")
        action = msg.get("action") or ""
        payload = msg.get("payload") or {}

        if action == "pick_files":
            self._handle_pick_files(req_id, payload)
            return
        if action == "pick_folder":
            self._handle_pick_folder(req_id, payload)
            return
        if action == "set_theme":
            self.apply_native_theme(payload.get("theme", "light"))
            self.reply(req_id, ok=True, data={"ok": True})
            return
        if action == "open_file":
            try:
                open_uri(Path(str(payload.get("path") or "")).resolve().as_uri())
                self.reply(req_id, ok=True, data={"ok": True})
            except Exception as err:
                self.reply(req_id, ok=False, error=error_details(err))
            return
        if action == "open_url":
            url = str(payload.get("url") or "")
            if not url.startswith(("http://", "https://")):
                self.reply(req_id, ok=False, error="Unsupported URL scheme")
                return
            try:
                open_uri(url)
                self.reply(req_id, ok=True, data={"ok": True})
            except Exception as err:
                self.reply(req_id, ok=False, error=error_details(err))
            return

        self.work.submit(self._dispatch_worker, req_id, action, payload)

    def _handle_pick_files(self, req_id, payload):
        dialog = Gtk.FileChooserNative.new(
            "Choose files to send",
            self,
            Gtk.FileChooserAction.OPEN,
            "Send",
            "Cancel",
        )
        dialog.set_select_multiple(True)
        response = dialog.run()
        paths = dialog.get_filenames() if response == Gtk.ResponseType.ACCEPT else []
        dialog.destroy()
        if not paths:
            self.reply(req_id, ok=True, data={"cancelled": True})
            return

        def send_job():
            try:
                res = queue_files_cli(payload, paths)
                self.reply(req_id, ok=True, data=res)
            except Exception as err:
                self.reply(req_id, ok=False, error=error_details(err))

        self.work.submit(send_job)

    def _handle_pick_folder(self, req_id, payload):
        dialog = Gtk.FileChooserNative.new(
            "Choose save folder",
            self,
            Gtk.FileChooserAction.SELECT_FOLDER,
            "Select",
            "Cancel",
        )
        current = str(payload.get("current") or "").strip()
        if current and Path(current).is_dir():
            dialog.set_current_folder(current)
        response = dialog.run()
        folder = dialog.get_filename() if response == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        if not folder:
            self.reply(req_id, ok=True, data={"cancelled": True})
            return
        self.reply(req_id, ok=True, data={"path": folder})

    def _dispatch_worker(self, req_id, action, payload):
        try:
            data = self._run_action(action, payload)
            self.reply(req_id, ok=True, data=data)
        except Exception as err:
            self.reply(req_id, ok=False, error=error_details(err))

    def _run_action(self, action, payload):
        if action == "snapshot":
            chat_id = str(payload.get("chatId") or DEFAULT_CHAT)
            active = service_active()
            snap = get_json("snapshot", "--chat", chat_id, "--limit", str(PAGE))
            GLib.idle_add(self.tray.set_snapshot, active, snap["status"], snap["chat_id"])
            return {
                "serviceActive": active,
                "trayAvailable": self.tray.available,
                "status": snap["status"],
                "chats": snap["chats"],
                "chatId": snap["chat_id"],
                "history": snap["history"],
                "progress": snap["progress"],
                "previews": snap.get("previews", []),
            }
        if action == "load_older":
            chat_id = str(payload.get("chatId") or DEFAULT_CHAT)
            before = str(int(payload.get("before", 0)))
            return get_json("history", "--json", "--chat", chat_id, "--before", before, "--limit", str(PAGE))
        if action == "search_messages":
            return get_json("search", "--", str(payload.get("query") or ""))
        if action == "shared_media":
            args = ["shared-media", str(payload.get("tab") or "files")]
            if payload.get("chatId"):
                args.extend(["--chat", str(payload["chatId"])])
            if payload.get("before") is not None:
                args.extend(["--before", str(int(payload["before"]))])
            return get_json(*args)
        if action == "transfer_control":
            return get_json(
                "transfer-control", str(payload["direction"]), str(payload["id"]), str(payload["action"])
            )
        if action in ("send_text", "send_image"):
            chat_id = str(payload.get("chatId") or DEFAULT_CHAT)
            is_text = action == "send_text"
            data = str(payload.get("text" if is_text else "base64") or "")
            args = ["send-text" if is_text else "send-image", "--chat", chat_id]
            if payload.get("replyTo"):
                args.extend(["--reply-to", str(payload["replyTo"])])
            if payload.get("ttl"):
                args.extend(["--ttl", str(int(payload["ttl"]))])
            if is_text:
                args.append("-")
            run_cli(*args, data=data)
            return {"ok": True}
        if action == "send_files":
            paths = [str(p) for p in (payload.get("paths") or []) if p]
            return queue_files_cli(payload, paths)
        if action == "new_chat":
            return get_json("new-chat")
        if action == "rename_chat":
            return get_json("rename-chat", str(payload.get("id") or ""), str(payload.get("title") or ""))
        if action == "delete_chat":
            return get_json("delete-chat", str(payload.get("id") or ""))
        if action == "message_text":
            return {"text": run_cli("message-text", str(payload.get("id") or ""))}
        if action == "delete_message":
            args = ["delete-message"]
            if payload.get("deleteFiles"):
                args.append("--delete-files")
            args.append(str(payload.get("id") or ""))
            run_cli(*args)
            return {"ok": True}
        if action == "delete_messages":
            ids = [str(i) for i in (payload.get("ids") or []) if i]
            if ids:
                args = ["delete-message"]
                if payload.get("deleteFiles"):
                    args.append("--delete-files")
                args.extend(ids)
                run_cli(*args)
            return {"ok": True}
        if action == "received_files":
            args = ["history", "--json", "--files", "--limit", str(PAGE)]
            if payload.get("before") is not None:
                args.extend(["--before", str(int(payload["before"]))])
            return get_json(*args)
        if action == "show_in_folder":
            show_in_file_manager(str(payload.get("path") or ""))
            return {"ok": True}
        if action == "open_receive_folder":
            folder = run_cli("receive-folder").strip()
            open_uri(Path(folder).resolve().as_uri())
            return {"ok": True}
        if action == "clear_history":
            run_cli("clear-history")
            return {"ok": True}
        if action == "lan_addresses":
            return get_json("lan-addresses")
        if action == "announce_hotspot":
            return get_json("announce-hotspot", "--address", str(payload.get("address") or ""))
        if action == "hotspot_status":
            return self.hotspot.status()
        if action == "hotspot_start":
            return self.hotspot.start(payload.get("device"))
        if action == "hotspot_stop":
            self.hotspot.stop()
            return {"ok": True}
        if action == "pair":
            try:
                service_ctl("start")
            except Exception:
                pass
            address = str(payload.get("address") or "")
            args = ["pair", "--address", address] if address else ["pair"]
            output = run_cli(*args).rstrip("\n")
            lines = output.split("\n")
            link = lines[-1] if lines else ""
            qr = "\n".join(lines[:-2]) if len(lines) >= 2 else ""
            return {"qr": qr, "link": link}
        if action == "unpair":
            run_cli("unpair")
            return {"ok": True}
        if action == "pause_service":
            service_ctl("stop")
            return {"serviceActive": False}
        if action == "resume_service":
            service_ctl("start")
            return {"serviceActive": True}
        if action == "set_prefs":
            prefs = payload.get("prefs") or {}
            save_prefs(prefs)
            self.minimize_to_tray = prefs.get("minimizeToTray") is True
            return {"ok": True}
        if action == "get_settings":
            return get_json("settings")
        if action == "set_settings":
            body = json.dumps(payload.get("settings") or {})
            return json.loads(run_cli("settings", "--stdin-json", data=body))
        if action == "test_sound":
            kind = str(payload.get("kind") or "message")
            run_cli("test-sound", kind)
            return {"ok": True}
        raise ValueError(f"Unknown action: {action}")


class PortalApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        for name in (
            "notify-chat",
            "notify-file",
            "notify-connected",
            "reply-to",
            "item-id",
            "file-path",
            "data-dir",
            "receive-dir",
        ):
            self.add_main_option(name, 0, GLib.OptionFlags.HIDDEN, GLib.OptionArg.STRING, "", "VALUE")

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.add_portal_action("reply", "(ssss)", self.reply_action)
        self.add_portal_action("open-chat", "s", self.open_chat_action)
        self.add_portal_action("open-file", "s", self.open_file_action)
        self.add_portal_action("open-app", None, lambda _a, _p: self.activate())

    def do_command_line(self, command):
        options = command.get_options_dict()

        def option(name):
            value = options.lookup_value(name, None)
            return value.get_string() if value else ""

        def read_stdin():
            source = command.get_stdin()
            return source.read_bytes(4096, None).get_data().decode(errors="replace").strip() if source else ""

        chat = option("notify-chat")
        file_chat = option("notify-file")
        connected = option("notify-connected")
        if chat:
            self.post_message_notification(
                chat,
                option("reply-to"),
                option("data-dir"),
                option("receive-dir"),
                read_stdin(),
            )
        elif file_chat:
            self.post_file_notification(
                file_chat,
                option("item-id"),
                option("file-path"),
                read_stdin(),
            )
        elif connected:
            self.post_connected_notification(connected, read_stdin())
        else:
            self.activate()
        return 0

    def add_portal_action(self, name, signature, callback):
        vtype = GLib.VariantType.new(signature) if signature else None
        action = Gio.SimpleAction.new(name, vtype)
        action.connect("activate", callback)
        self.add_action(action)

    def post_message_notification(self, chat, reply_to, data_dir, receive_dir, preview):
        notification = Gio.Notification.new("New message")
        notification.set_body(preview or "New message received")
        notification.set_icon(Gio.ThemedIcon.new(APP_ID))
        notification.set_category("im.received")
        notification.set_default_action_and_target("app.open-chat", GLib.Variant("s", chat))
        target = GLib.Variant("(ssss)", (chat, reply_to, data_dir, receive_dir))
        notification.add_button_with_target("Reply", "app.reply", target)
        self.send_notification(reply_to or chat, notification)

    def post_file_notification(self, chat, item_id, file_path, filename):
        notification = Gio.Notification.new("File received")
        notification.set_body(filename or "File saved in Downloads/Portal Drop")
        notification.set_icon(Gio.ThemedIcon.new(APP_ID))
        notification.set_category("transfer.complete")
        notification.set_default_action_and_target("app.open-chat", GLib.Variant("s", chat))
        if file_path:
            notification.add_button_with_target("Open file", "app.open-file", GLib.Variant("s", file_path))
        self.send_notification(item_id or f"file-{chat}", notification)

    def post_connected_notification(self, peer_label, body):
        notification = Gio.Notification.new("Device connected")
        notification.set_body(body or f"{peer_label} is now connected")
        notification.set_icon(Gio.ThemedIcon.new(APP_ID))
        notification.set_category("device.added")
        notification.set_default_action("app.open-app")
        self.send_notification("portal-connected", notification)

    def reply_action(self, _, parameter):
        chat, reply_to, _data_dir, _receive_dir = parameter.unpack()
        self.activate()
        window = self.get_active_window()
        if window is not None:
            window.open_chat(chat, reply_to or None)

    def open_chat_action(self, _, parameter):
        self.activate()
        window = self.get_active_window()
        if window is not None:
            window.open_chat(parameter.get_string())

    def open_file_action(self, _, parameter):
        path = parameter.get_string()
        try:
            open_uri(Path(path).resolve().as_uri())
        except Exception:
            self.activate()

    def do_activate(self):
        window = self.get_active_window() or next(iter(self.get_windows()), None)
        if window is None:
            window = PortalWindow(self)
        window.restore()


if __name__ == "__main__":
    GLib.set_prgname(APP_ID)
    GLib.set_application_name("Portal Drop")
    arguments = sys.argv.copy()
    if len(sys.argv) == 3 and sys.argv[1] in ("--notify-chat", "--notify-file", "--notify-connected"):
        for flag, setting in (
            ("--reply-to", "PORTAL_DROP_REPLY_TO"),
            ("--item-id", "PORTAL_DROP_ITEM_ID"),
            ("--file-path", "PORTAL_DROP_FILE_PATH"),
            ("--data-dir", "PORTAL_DROP_DATA_DIR"),
            ("--receive-dir", "PORTAL_DROP_RECEIVE_DIR"),
        ):
            if os.environ.get(setting):
                arguments.extend((flag, os.environ[setting]))
    raise SystemExit(PortalApplication().run(arguments))
